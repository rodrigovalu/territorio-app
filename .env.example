# Copie para .env e preencha. NUNCA coloque aqui a service_role key do Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
# OAuth client ID do tipo "Aplicativo da Web" no Google Cloud (usado pelo login nativo)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Chave do Google Maps restrita ao pacote Android + SHA-1
GOOGLE_MAPS_ANDROID_API_KEY=
ANDROID_PACKAGE=br.com.territorio.app
EAS_PROJECT_ID=
